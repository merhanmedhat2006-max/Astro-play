# Copy this file to ".env" and fill it in. Never share or commit your real .env.

# Get a free Gemini API key at https://aistudio.google.com/apikey
ASTRO_LLM_PROVIDER=gemini
GEMINI_API_KEY=your-key-here

# Model used by the AI Space Assistant. "gemini-flash-latest" always points at the newest Flash model.
# If your key can't use it, the game tries the fallbacks below, then offline answers.
ASTRO_LLM_MODEL=gemini-flash-latest
# ASTRO_LLM_FALLBACKS=gemini-2.5-flash,gemini-2.5-flash-lite
# ASTRO_LLM_TIMEOUT=25

# Optional path overrides
# ASTRO_DB_PATH=data/astro_play.db
# ASTRO_CHROMA_DIR=data/chroma
